# ── Dependencies & build output ──────────────────────────────
node_modules/
out/
dist/
dist-extension/
dist-capacitor/
dist-ios/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# ── Android (Capacitor) — native project is committed, outputs are not ──
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
android/keystore.b64.txt
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
*.keystore
*.jks

# Play Console service-account key. This can publish to the store unattended —
# keep it out of the repo entirely (see scripts/play-publish.mjs).
play-service-account*.json
*-play-sa.json
# Google's default download name is <cloud-project-id>-<keyid>.json
magic-money-*.json

# ── iOS (Capacitor) — native project is committed, outputs are not ──
# Mirrors the Android policy above. Pods/ is restored by `pod install` during
# the CI build; the synced web bundle lands in App/public and is regenerated
# by every `cap sync ios`.
ios/App/Pods/
ios/App/build/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/App/config.xml
ios/DerivedData/
ios/App/output/
*.xcuserstate
xcuserdata/

# ── Secrets / local env ──────────────────────────────────────
.env
.env.*
.dev.vars
*.enc

# Wrangler local state. Never commit this: cache/cf.json is a captured request
# object from a `wrangler dev` session and carries the developer's city, ISP and
# coordinates, and cache/wrangler-account.json carries the Cloudflare account id
# and email. state/ and tmp/ are just miniflare scratch. All of it regenerates.
.wrangler/
# Test-only Midnight Preprod wallet seed (dev tooling, never real funds)
.midnight-preprod-test-wallet.json
.midnight-preprod-dust-state.json
.midnight-preprod-quiescent-dust-state.json
.midnight-preprod-roundtrip-report.json
.midnight-sync-complete.flag

# ── Claude Code (keep shared settings.json; ignore personal) ──
.claude/settings.local.json

# ── Generated audit report (review artifact — safe to delete) ─
audit-report/

# ── OS / editor cruft ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
Gemini_Advice.md
/.ChainLens_Files/
ChainLens_Files/backend-server.js
ChainLens_Files/DESIGN.md
ChainLens_Files/index.html
ChainLens_Files/README.md
ChainLens_Files/stlyes.css

# ── Magic Guard native (generated build outputs) ─────────────
native/magic-guard-core/target/
android/app/src/main/jniLibs/

# Magic Guard iOS converter (build tool) — generated rulesets ARE committed
native/magic-guard-cb/target/

# Passkey onboarding preview renders — regenerate with scripts/passkey-onboarding-shots.mjs.
# Harness output, NOT device captures; committing them invites treating them as proof.
.screenshots/
