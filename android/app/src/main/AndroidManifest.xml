<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- allowBackup=false: never let the encrypted vault ride device/cloud backups -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Marks the app as a web browser for Android's launcher/defaults UI -->
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>

            <!-- WalletConnect deep links: wc:… URIs pair directly (CapApp appUrlOpen) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wc" />
            </intent-filter>

            <!--
              Web links. Scheme-only data entries (NO host) are what makes Android
              treat MagicMoney as a general-purpose browser: RoleManager's
              ROLE_BROWSER eligibility check queries exactly this shape, and it is
              also what puts the app in the "Open with" chooser for any link.
              CapApp routes the resulting appUrlOpen into the in-app dApp browser.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Lets the wallet appear beside Google Password Manager and Samsung
             Pass under Settings > Passwords, passkeys & accounts, so its
             seed-derived passkeys work in every browser.

             android:permission restricts binding to the system. Android 14+
             only (CredentialProviderService); below that the service is never
             bound and nothing else changes.

             The service itself does NO crypto and has no UI: it only lists which
             credentials could be used. Every signature happens in PasskeyActivity
             behind a BiometricPrompt. The user must enable the provider in
             Settings before any of it is ever called. -->
        <service
            android:name="info.chainlens.magicmoney.passkey.MagicMoneyCredentialProviderService"
            android:enabled="true"
            android:exported="true"
            android:label="Magic Money"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE"
            tools:targetApi="upside_down_cake">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/provider" />
        </service>

        <!-- Launched by a CredentialEntry's PendingIntent. Runs the biometric and
             the ceremony, then returns through PendingIntentHandler.

             Not exported: only our own service's PendingIntent starts it, and a
             PendingIntent carries our identity, so nothing else can reach it.
             excludeFromRecents + the translucent theme keep the system's own
             credential sheet looking like one screen rather than two. -->
        <activity
            android:name="info.chainlens.magicmoney.passkey.PasskeyActivity"
            android:enabled="true"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop"
            android:theme="@style/MagicMoneyPasskeyDialog"
            tools:targetApi="upside_down_cake" />
    </application>

    <!--
      Package visibility (Android 11+): without this, resolveActivity() for a web
      link returns nothing and the "am I the default browser?" check would always
      read false on devices below API 29 (where RoleManager isn't available).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- QR scanning (WalletConnect pairing, send-address entry) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Biometric unlock (BiometricPrompt) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Passkeys in the dApp browser. WebView's FOR_BROWSER WebAuthn mode calls
         Credential Manager on behalf of the VISITED site, which requires the
         calling app to be allowed to set the request origin. Normal protection
         level — no runtime prompt, no user-visible permission. -->
    <uses-permission android:name="android.permission.CREDENTIAL_MANAGER_SET_ORIGIN" />
    <!-- Saving images/files from the dApp browser via DownloadManager. Scoped
         storage (API 29+) needs no permission for the public Downloads folder,
         so this is capped at 28 rather than requested on modern devices. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
</manifest>
