{
  "name": "magicmoney-wallet",
  "version": "0.1.1",
  "description": "Self-custody multi-chain wallet — EVM · Solana · Cardano",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "build:inject": "npx esbuild src/preload/web3-inject.ts src/preload/popup-chrome.ts src/preload/popup-connect.ts src/preload/approval-preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=out/inject",
    "apphub": "node scripts/convert-apphub.js",
    "icons": "node scripts/generate-icons.js",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "npm run build:extension && playwright test",
    "test:watch": "vitest",
    "predev": "node scripts/convert-apphub.js",
    "dev": "npm run build:inject && electron-vite dev",
    "prebuild": "node scripts/convert-apphub.js",
    "build": "electron-vite build && npm run build:inject",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "package:publish": "npm run build && electron-builder --publish always",
    "prebuild:extension": "node scripts/convert-apphub.js",
    "build:extension": "vite build --config vite.extension.config.ts",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "dependencies": {
    "@abstract-foundation/agw-client": "^1.11.0",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "@scure/base": "^1.1.6",
    "@scure/bip32": "^1.4.0",
    "@scure/bip39": "^1.3.0",
    "@scure/btc-signer": "^2.2.0",
    "@solana/web3.js": "^1.95.8",
    "@supabase/supabase-js": "^2.108.2",
    "@walletconnect/sign-client": "^2.23.9",
    "@walletconnect/types": "^2.23.9",
    "@walletconnect/utils": "^2.23.9",
    "ed25519-hd-key": "^1.3.0",
    "electron-updater": "^6.8.9",
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.9",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.1",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "jayson": {
      "uuid": "11.1.1"
    },
    "ws": "8.21.0"
  },
  "build": {
    "appId": "com.magicmoney.wallet",
    "productName": "MagicMoney Wallet",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "publish": {
      "provider": "github"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
