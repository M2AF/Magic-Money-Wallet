{
  "name": "magicmoney-wallet",
  "version": "0.6.1",
  "description": "Self-custody multi-chain wallet — EVM · Solana · Cardano",
  "author": {
    "name": "ChainLens",
    "email": "guildfordking@gmail.com"
  },
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "build:inject": "npx esbuild src/preload/web3-inject.ts src/preload/popup-chrome.ts src/preload/popup-connect.ts src/preload/approval-preload.ts src/preload/passkey-preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=out/inject && npx esbuild src/renderer/lib/passkey-ceremony-entry.ts --bundle --platform=browser --format=iife --outfile=out/inject/passkey-ceremony.js",
    "apphub": "node scripts/convert-apphub.js",
    "icons": "node scripts/generate-icons.js",
    "icons:android": "node scripts/generate-android-icons.js",
    "icons:ios": "node scripts/generate-ios-icons.js",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.extension.json && tsc --noEmit -p tsconfig.capacitor.json && tsc --noEmit -p tsconfig.ios.json",
    "test": "vitest run",
    "test:e2e": "npm run build:extension && playwright test",
    "test:e2e:app": "npm run build && playwright test e2e/electron-smoke.spec.ts e2e/magic-guard.spec.ts",
    "test:tor": "esbuild src/main/tor-manager.ts --bundle --platform=node --format=cjs --external:electron --outfile=out/tor-smoke-manager.cjs && electron scripts/tor-smoke.cjs",
    "test:magic-guard-engine": "electron scripts/magic-guard-engine-smoke.cjs",
    "test:watch": "vitest",
    "postinstall": "patch-package",
    "predev": "node scripts/convert-apphub.js",
    "dev": "npm run build:inject && electron-vite dev",
    "prebuild": "node scripts/convert-apphub.js",
    "build": "electron-vite build && npm run build:inject",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "package:publish": "npm run build && electron-builder --publish always",
    "prebuild:extension": "node scripts/convert-apphub.js",
    "build:extension": "vite build --config vite.extension.config.ts",
    "prebuild:capacitor": "node scripts/convert-apphub.js",
    "build:capacitor": "vite build --config vite.capacitor.config.ts && npx cap sync android",
    "android": "npm run build:capacitor && npx cap run android",
    "android:apk": "npm run build:capacitor && cd android && gradlew assembleRelease",
    "android:aab": "npm run build:capacitor && cd android && gradlew bundleRelease",
    "android:dev": "vite --config vite.capacitor.config.ts --port 5183 --host",
    "prebuild:ios": "node scripts/convert-apphub.js",
    "build:ios": "vite build --config vite.ios.config.ts && node scripts/patch-ios-plist.js && node scripts/patch-ios-native.js && node scripts/cap.js sync ios",
    "ios": "npm run build:ios && node scripts/cap.js run ios",
    "ios:dev": "vite --config vite.ios.config.ts --port 5184 --host",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "magic-guard:ios": "cargo run --release --manifest-path native/magic-guard-cb/Cargo.toml -- resources/magic-guard resources/magic-guard/ios"
  },
  "dependencies": {
    "@abstract-foundation/agw-client": "^1.11.0",
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/android": "^7.6.7",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.7",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/capacitor-native-biometric": "^7.6.0",
    "@midnight-ntwrk/ledger-v8": "^8.1.0",
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.3",
    "@midnight-ntwrk/zkir-v2": "^2.1.0",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@midnightntwrk/wallet-sdk": "^1.2.0",
    "@midnightntwrk/wallet-sdk-abstractions": "^2.1.0",
    "@midnightntwrk/wallet-sdk-address-format": "^3.1.2",
    "@midnightntwrk/wallet-sdk-capabilities": "^3.3.1",
    "@midnightntwrk/wallet-sdk-dust-wallet": "^4.2.0",
    "@midnightntwrk/wallet-sdk-facade": "^4.1.0",
    "@midnightntwrk/wallet-sdk-prover-client": "^1.2.3",
    "@midnightntwrk/wallet-sdk-shielded": "^3.0.2",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "^3.1.0",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "@scure/base": "^1.1.6",
    "@scure/bip32": "^1.4.0",
    "@scure/bip39": "^1.3.0",
    "@scure/btc-signer": "^2.2.0",
    "@solana/web3.js": "^1.95.8",
    "@walletconnect/sign-client": "^2.23.9",
    "@walletconnect/types": "^2.23.9",
    "@walletconnect/utils": "^2.23.9",
    "adblock-rs": "0.13.2",
    "ed25519-hd-key": "^1.3.0",
    "electron-updater": "^6.8.9",
    "monero-ts": "^0.11.10",
    "qrcode": "^1.5.4",
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.7",
    "@playwright/test": "^1.61.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.9",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "patch-package": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.1",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "jayson": {
      "uuid": "11.1.1"
    },
    "ws": "8.21.0"
  },
  "build": {
    "appId": "com.magicmoney.wallet",
    "productName": "MagicMoney Wallet",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "!node_modules/adblock-rs/target/**",
      "!node_modules/adblock-rs/src/**",
      "!node_modules/adblock-rs/benches/**",
      "!node_modules/adblock-rs/fuzz/**",
      "!node_modules/adblock-rs/js/test/**"
    ],
    "extraResources": [
      {
        "from": "resources/browser-icon.ico",
        "to": "browser-icon.ico"
      }
    ],
    "publish": {
      "provider": "github"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
