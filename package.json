{
  "name": "magicmoney-wallet",
  "version": "0.1.0",
  "description": "Self-custody multi-chain wallet — EVM · Solana · Cardano",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "build:inject": "npx esbuild src/preload/web3-inject.ts --bundle --platform=node --format=cjs --external:electron --outfile=out/main/web3-inject.js",
    "dev": "npm run build:inject && electron-vite dev",
    "build": "electron-vite build && npm run build:inject",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:publish": "electron-vite build && electron-builder --publish always",
    "build:extension": "vite build --config vite.extension.config.ts",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "@scure/base": "^1.1.6",
    "@scure/bip32": "^1.4.0",
    "@scure/bip39": "^1.3.0",
    "@solana/web3.js": "^1.95.8",
    "@supabase/supabase-js": "^2.108.2",
    "@walletconnect/sign-client": "^2.23.9",
    "@walletconnect/types": "^2.23.9",
    "@walletconnect/utils": "^2.23.9",
    "bufferutil": "^4.1.0",
    "ed25519-hd-key": "^1.3.0",
    "electron-updater": "^6.8.9",
    "utf-8-validate": "^6.0.6",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "build": {
    "appId": "com.magicmoney.wallet",
    "productName": "MagicMoney Wallet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "publish": {
      "provider": "github"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
